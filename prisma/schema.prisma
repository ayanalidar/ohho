// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  phone         String?
  role          String    @default("CUSTOMER") // CUSTOMER | ADMIN | OPERATOR
  locationId    String?   // for OPERATOR role: which location they manage
  addresses     String?   // JSON string of saved addresses
  loyaltyPoints Int       @default(0)
  walletBalance Int       @default(0) // in paise (₹1 = 100)
  referralCode  String    @unique
  referredBy    String?   // referral code of the user who referred them
  upiId         String?   // editable UPI ID for merchant payments
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  reviews       Review[]
  franchiseLeads FranchiseLead[]
  cateringInquiries CateringInquiry[]
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  achievements  UserAchievement[]
}

model Order {
  id              String      @id @default(cuid())
  orderId         String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  subtotal        Int
  deliveryFee     Int
  taxes           Int
  walletDebit     Int         @default(0)
  total           Int
  mode            String      // delivery | pickup
  status          String      @default("PREPARING")
  address         String?
  paymentMethod   String
  paymentStatus   String      @default("PAID")
  etaSeconds      Int         @default(1500)
  progress        Float       @default(0)
  invoiceNumber   String?     @unique
  notes           String?
  locationId      String?
  rated           Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  review          Review?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String
  name      String
  emoji     String
  image     String
  price     Int
  qty       Int
  addOns    String?
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String?
  itemName  String?
  itemId    String?
  createdAt DateTime @default(now())
}

model FranchiseLead {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  city          String
  locationType  String
  investment    String
  timeline      String
  message       String?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
}

model CateringInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  eventType   String
  eventDate   String
  guestCount  Int
  budget      String
  message     String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
}

model ReferralRedemption {
  id          String   @id @default(cuid())
  referrerId  String
  refereeId   String
  code        String
  orderId     String?
  rewardGiven Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─── Admin-editable content models ───────────────────────

model MenuItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  emoji       String
  description String
  ingredients String   // JSON array
  image       String
  category    String   // Burgers | Pizza | Sandwiches | Buckets | Sips | Add-ons
  price       Int
  kcal        Int
  prepTime    String
  spice       Int      @default(0)
  tag         String?
  isAddOn     Boolean  @default(false)
  signature   Boolean  @default(false)
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CateringPackage {
  id          String   @id @default(cuid())
  name        String
  pax         String
  price       String
  items       String   // JSON array
  note        String?
  color       String   @default("#ff6a00")
  sortOrder   Int      @default(0)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TimelineEra {
  id          String   @id @default(cuid())
  category    String   @unique  // Burgers | Pizza | Sandwiches | Buckets | Sips | Add-ons
  label       String
  emoji       String
  color       String
  tagline     String
  year        String
  era         String
  blurb       String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id              String   @id @default(cuid())
  slug            String   @unique  // kairana | shamli
  name            String
  city            String
  area            String
  status          String   @default("operational") // operational | coming-soon
  rating          Float    @default(4.8)
  customers       Int      @default(0)
  deliveryRadiusKm Int     @default(5)
  prepTimeExtra   String   @default("0 min")
  image           String
  active          Boolean  @default(true)
  opensOn         DateTime? // for coming-soon locations — countdown target
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
}

model TodaySpecial {
  id          String   @id @default(cuid())
  title       String
  description String
  code        String?  // promo code
  badge       String   @default("🔥 Today's Special")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserAchievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   // first-order | 10-orders | gold-tier | reviewer | etc.
  name        String
  description String
  icon        String
  unlockedAt  DateTime @default(now())

  @@unique([userId, slug])
}
